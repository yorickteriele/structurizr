# Copy this file to .env and adjust. Docker Compose reads .env automatically.

# Folder containing your workspace.dsl (absolute or relative to this folder)
# e.g. on Windows: STRUCTURIZR_WORKSPACE=D:/projects/my-architecture
STRUCTURIZR_WORKSPACE=./docker/workspace

# Port for Structurizr local on your machine (http://localhost:8080)
STRUCTURIZR_PORT=8080
